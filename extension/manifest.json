{
  "manifest_version": 3,
  "name": "PDF Wizard: X Video Downloader",
  "short_name": "PDF Wizard X",
  "version": "1.0.0",
  "description": "Adds a Download button to videos on X (Twitter). Save them as MP4 or MP3 with PDF Wizard.",
  "homepage_url": "https://pdfwizard.xyz/tools/x-to-mp4",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*", "https://mobile.twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
