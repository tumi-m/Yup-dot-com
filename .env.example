# ---------- Supabase ----------
# Project URL and anon key from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (server only — never expose to the browser).
# Used by the Stripe webhook to update plans.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- App ----------
# Public site URL, used as a fallback for Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring price IDs for each paid plan (Stripe → Products → Pricing)
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_TEAM=price_xxx
