# Every variable below is OPTIONAL. With none of them set, the app still builds,
# deploys, and serves the marketing site plus all browser-only PDF tools.
# They unlock accounts, the cloud library, the editor, and billing.

# ---------- Supabase ----------
# Project URL and anon key from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (server only — never expose to the browser).
# Used by the Stripe webhook to update plans.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- App ----------
# Canonical URL for metadata, sitemap.xml, and Stripe redirects.
# On Vercel this falls back to the deployment URL automatically — set it only
# for a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Self-hosted pdf.js worker, for deployments behind a strict CSP.
# NEXT_PUBLIC_PDFJS_WORKER_SRC=/pdf.worker.min.mjs

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring price IDs for each paid plan (Stripe → Products → Pricing)
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_TEAM=price_xxx
