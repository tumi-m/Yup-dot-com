# Every variable below is OPTIONAL. With none of them set, the app still builds,
# deploys, and serves the marketing site, every browser tool (PDF and PPTX),
# Google Slides downloads and X downloads. They unlock accounts, the cloud
# library, the AI assistant, YouTube downloads, and billing.

# ---------- Supabase ----------
# Project URL and anon key from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (server only — never expose to the browser).
# Billing needs it: it records payments, plans and team seats. Daily limits
# (AI answers, edits, downloads, imports) use it to count in Supabase; without
# it they are counted in server memory, per instance.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- App ----------
# Canonical URL for metadata, sitemap.xml, and the Paystack return URL.
# On Vercel this falls back to the deployment URL automatically (VERCEL_URL,
# VERCEL_PROJECT_PRODUCTION_URL, set by Vercel) — set it only for a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Self-hosted pdf.js worker, for deployments behind a strict CSP.
# NEXT_PUBLIC_PDFJS_WORKER_SRC=/pdf.worker.min.mjs

# ---------- Business details (legal pages, contact page, footer) ----------
# Shown on /privacy, /terms, /refunds and /contact. Paystack's activation
# review and POPIA expect a responsible person, an email and a physical
# address. In development a missing value shows as a highlighted placeholder;
# in production it is left out. NEXT_PUBLIC_*: redeploy after changing.
# NEXT_PUBLIC_BUSINESS_NAME=PDF Wizard
# The person or company legally responsible (POPIA "responsible party").
# NEXT_PUBLIC_LEGAL_NAME=Your Full Name
# NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com
# Optional.
# NEXT_PUBLIC_CONTACT_PHONE=+27 82 000 0000
# NEXT_PUBLIC_BUSINESS_ADDRESS=Street, Suburb, City, Postal code

# ---------- Google Analytics 4 and search engines ----------
# GA4 measurement ID (G-XXXXXXXXXX). Unset: no analytics and no cookie banner.
# Set: a banner asks first; gtag.js loads only after the visitor accepts.
# Set it for Production only, so previews don't count.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Search Console "HTML tag" token (only the content="…" value). Not needed if
# you verify the domain with a DNS TXT record instead.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools msvalidate.01 token (or import the site from Search Console).
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---------- Billing (Paystack, ZAR) ----------
# Paystack → Settings → API Keys & Webhooks. Server only. Use sk_test_… while
# testing. The same key verifies webhook signatures.
PAYSTACK_SECRET_KEY=sk_test_xxx
# Plan codes from Paystack → Products → Plans: Pro R49/month, Team R199/month.
PAYSTACK_PLAN_PRO=PLN_xxx
PAYSTACK_PLAN_TEAM=PLN_xxx
# Webhook URL to set in Paystack: https://<your-domain>/api/billing/webhook

# ---------- AI assistant (Chat with PDF) ----------
# Enables /tools/chat-with-pdf. Server-only. Ollama Cloud by default; set
# OLLAMA_HOST instead to use your own Ollama server.
OLLAMA_API_KEY=xxx
# OLLAMA_HOST=https://ollama.com
# OLLAMA_MODEL=deepseek-v4.1-flash
# Reasoning level: low (default for DeepSeek V4.1 Flash), medium, high, max, false
# OLLAMA_THINK=low
# Context window to ask for (num_ctx, at least 8192). Unset: the model's default.
# OLLAMA_CONTEXT_TOKENS=
# Answers per day: guest 3 (0 = sign-in required), free 10, pro 40 (600 a
# month), team 40 per member. 6 a minute per person; 3000 a day site-wide.
# A _MONTH value of 0 means no monthly cap. AI_GUEST_DAILY_LIMIT is the older
# name for AI_LIMIT_GUEST_DAY.
# AI_LIMIT_GUEST_DAY=3
# AI_GUEST_DAILY_LIMIT=3
# AI_LIMIT_GUEST_MONTH=0
# AI_LIMIT_FREE_DAY=10
# AI_LIMIT_FREE_MONTH=0
# AI_LIMIT_PRO_DAY=40
# AI_LIMIT_PRO_MONTH=600
# AI_LIMIT_TEAM_DAY=40
# AI_LIMIT_TEAM_MONTH=0
# AI_BURST_PER_MINUTE=6
# AI_GLOBAL_DAILY_LIMIT=3000

# ---------- Usage counters ----------
# Secret salt for hashing guest IPs (raw IPs are never stored). Optional:
# falls back to one derived from SUPABASE_SERVICE_ROLE_KEY or MEDIA_SIGNING_SECRET.
USAGE_HASH_SALT=generate-a-long-random-string

# ---------- Video downloads (YouTube, X) ----------
# X downloads work without any of these. YouTube needs the media worker
# (see media-worker/README.md): its public URL and the secret it shares with
# this app. Check the setup at /api/media/health.
MEDIA_WORKER_URL=https://media.your-domain.com
MEDIA_WORKER_SECRET=generate-a-long-random-string
# Signs X download links. Optional if MEDIA_WORKER_SECRET is set.
MEDIA_SIGNING_SECRET=generate-another-long-random-string
# Local testing only (ignored in production): extra hosts /api/media/file may fetch.
# MEDIA_TEST_HOSTS=
